{
  "name": "bosspilot",
  "description": "BossPilot — 本地优先、由 Skills 驱动的可扩展浏览器 AI Agent（BYOK / MCP / 商业使用需授权）",
  "private": true,
  "version": "1.4.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "keywords": [
    "chrome-extension",
    "browser-extension",
    "ai-agent",
    "agent-skills",
    "mcp",
    "browser-automation",
    "local-first",
    "job-search",
    "zhipin",
    "boss-zhipin",
    "llm",
    "byok",
    "wxt",
    "react",
    "sidepanel",
    "mv3"
  ],
  "homepage": "https://github.com/little077/BossPilot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/little077/BossPilot.git"
  },
  "bugs": {
    "url": "https://github.com/little077/BossPilot/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:dev": "wxt build --mode development",
    "build:prod": "wxt build --mode production",
    "build:firefox": "wxt build -b firefox",
    "mv3:check": "node scripts/check-mv3-background.mjs",
    "bundle:check": "npm run mv3:check && node scripts/check-bundle-size.mjs",
    "zip": "wxt zip",
    "zip:dev": "wxt zip --mode development",
    "zip:prod": "wxt zip --mode production",
    "compile": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:ci": "biome ci .",
    "check:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "security:audit": "npm audit --audit-level=high",
    "quality": "npm run check:ci && npm run compile && npm run test:coverage && npm run security:audit",
    "verify": "npm run quality && npm run build && npm run bundle:check && npm run test:e2e",
    "icons": "node scripts/render-icons.mjs",
    "postinstall": "wxt prepare && simple-git-hooks"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@earendil-works/pi-ai": "0.84.1",
    "@mistralai/mistralai": "2.2.6",
    "@modelcontextprotocol/client": "2.0.0",
    "@mozilla/readability": "0.6.0",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "clsx": "^2.1.1",
    "dexie": "^4.0.10",
    "jszip": "^3.10.1",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^3.6.0",
    "turndown": "^7.2.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@commitlint/cli": "19.6.1",
    "@commitlint/config-conventional": "19.6.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/chrome": "^0.0.287",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/turndown": "^5.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "@wxt-dev/module-react": "1.2.2",
    "acorn": "8.18.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1",
    "lint-staged": "16.4.0",
    "sharp": "^0.35.3",
    "simple-git-hooks": "2.13.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "4.1.10",
    "wxt": "0.21.3"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "npx --no -- commitlint --edit \"$1\"",
    "pre-push": "npm run quality"
  },
  "allowScripts": {
    "simple-git-hooks@2.13.1": true
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,json,jsonc,css}": "biome check --write"
  }
}
